# Server-side environment variables
DATABASE_URL=postgresql://...
# Optional: set this to use a username such as MHDSRK instead of ADMIN_EMAIL
# Generate with: node scripts/hash-admin-password.mjs
ADMIN_PASSWORD_HASH=scrypt$16384$8$1$generated-salt$generated-hash
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret
LEAD_SESSION_SECRET=replace-with-another-long-random-secret

# Google Sheets lead sync
# Share the target Google Sheet with this service-account email as an Editor.
GOOGLE_SHEET_ID=
GOOGLE_SHEET_NAME=Leads
GOOGLE_SITE_VISIT_SHEET_NAME=Site Visits
GOOGLE_SERVICE_ACCOUNT_JSON=

# WhatsApp Cloud API notifications
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Meta WhatsApp webhook security
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_NAME=disun_welcome_message
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_TEMPLATE_IMAGE_URL=
WHATSAPP_GRAPH_API_VERSION=v26.0

# Internal lead notification recipient/template
# Use the full WhatsApp number with country code, without + or spaces.
WHATSAPP_LEAD_NOTIFICATION_PHONE=
WHATSAPP_LEAD_NOTIFICATION_TEMPLATE_NAME=disun_lead_notification
WHATSAPP_LEAD_NOTIFICATION_TEMPLATE_LANGUAGE=en_US

# Comma-separated company/Kerala dates when site visits are unavailable
SITE_VISIT_HOLIDAYS=

# Admin v2: JSON array of partner accounts. Each passwordHash is generated with scripts/hash-admin-password.mjs.
ADMIN_ACCOUNTS='[{"name":"SK","email":"sk","passwordHash":"scrypt$..."},{"name":"SRK","email":"srk","passwordHash":"scrypt$..."}]'
CRON_SECRET=replace-with-a-long-random-secret
WHATSAPP_FOLLOWUP_TEMPLATE_NAME=disun_followup_reminder
WHATSAPP_FOLLOWUP_TEMPLATE_LANGUAGE=en_US
